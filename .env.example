AWS_PROFILE=
# Google IdP (optional — only required if you want Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional custom domain (not required; if not provided a domain prefix will be generated)
CUSTOM_AUTH_DOMAIN=
DOMAIN_PREFIX=
# Optional app callback/logout URLs (comma-separated). If omitted, defaults to common local / deep-link urls
APP_CALLBACK_URLS=
APP_LOGOUT_URLS=

TABLE_REMOVAL_POLICY=destroy

# Apple IdP (optional — only required if you want Apple sign-in)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=
